{
  "name": "kira-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev":            "next dev --port 3001",
    "build":          "next build",
    "start":          "next start --port 3001",
    "lint":           "eslint",
    "electron:dev":   "electron .",
    "electron:build": "npm run build && node electron/copy-static.js && electron-builder"
  },
  "build": {
    "appId":       "com.kiratakip.app",
    "productName": "Kira Takip",
    "directories": { "output": "dist" },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon":   "electron/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon":   "electron/icon.icns"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react":   "^0.576.0",
    "next":           "16.1.6",
    "prisma":         "^5.22.0",
    "react":          "19.2.3",
    "react-dom":      "19.2.3",
    "recharts":       "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss":  "^4",
    "@types/node":           "^20",
    "@types/react":          "^19",
    "@types/react-dom":      "^19",
    "dotenv":                "^17.3.1",
    "electron":              "^40.6.1",
    "electron-builder":      "^26.8.1",
    "eslint":                "^9",
    "eslint-config-next":    "16.1.6",
    "tailwindcss":           "^4",
    "typescript":            "^5"
  }
}
