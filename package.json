{
  "name": "kira-app",
  "version": "1.0.0",
  "description": "Rental and property management application for Turkish landlords",
  "author": "alperdb",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --port 3001",
    "generate": "prisma generate && prisma generate --schema=prisma/auth.prisma",
    "build": "npm run generate && next build",
    "start": "next start --port 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:build": "npm run build && node electron/copy-static.js && electron-builder --dir && node electron/make-zip.js",
    "electron:build:win": "node electron/setup-win-cache.js && npm run build && node electron/copy-static.js && electron-builder --win dir --x64 && node electron/make-zip.js",
    "electron:build:win:installer": "npm run build && node electron/copy-static.js && electron-builder --win --x64",
    "electron:build:mac": "npm run build && node electron/copy-static.js && electron-builder --mac --x64 --arm64",
    "release": "node electron/setup-win-cache.js && npm run build && node electron/copy-static.js && electron-builder --win dir --x64 --publish never && node electron/make-zip.js && node scripts/github-release.js"
  },
  "build": {
    "appId": "com.kiratakip.app",
    "productName": "Kira Takip",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "!.next/standalone/**/node_modules/.bin",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^5.4.2",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
